# Tool version pins for CI (update to concrete, tested versions before committing)

# Recommended golangci-lint release tag (github.com/golangci/golangci-lint)
# v2.x is required: v1 cannot parse Go 1.25+ export data.
export GOLANGCI_LINT_VERSION=v2.14.0

# Recommended staticcheck release tag (github.com/dominikh/go-tools)
export STATICCHECK_VERSION=v0.6.1

# govulncheck tool version (golang.org/x/vuln)
export GOVULNCHECK_VERSION=v1.1.4
